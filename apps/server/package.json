{
  "name": "@aws-ehr/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:seed": "tsx src/database/seed.ts",
    "db:migrate:auth": "npm run db:migrate",
    "auth:link": "tsx src/features/users/link-cognito.ts",
    "test": "tsx --test src/middleware/*.test.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "test:integration": "node ../../scripts/test-database.mjs"
  },
  "dependencies": {
    "aws-jwt-verify": "^5.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.3",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
